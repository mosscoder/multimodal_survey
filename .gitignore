# Secrets — API tokens such as HF_TOKEN. Never commit.
.env

# macOS / editor cruft. Previously only caught by a personal global gitignore;
# pinned here so it's ignored for every collaborator, not just one machine.
.DS_Store

# Python bytecode.
**/__pycache__/

# Local archives / backups. Not versioned.
*.tgz
*.tar.gz
*.zip

# Large binary formats — weights/arrays/orthomosaics by extension. The build's
# local ortho cache and any scratch rasters fall under *.tif.
*.pt
*.npz
*.npy
*.tif

# Built HF dataset artifacts and the ortho download cache (large, rebuildable
# from missions/ + GCS via `python -m multimodal_dataset build`).
multimodal_dataset/out/
multimodal_dataset/cache/

# Pre-reorg mission dir, already committed: 3 early runs (2026-06-11/-15) not
# duplicated under missions/site_1/strip_3/ — NOT a redundant copy, leave as
# is. This rule only keeps new stray files out; existing tracked files are
# unaffected.
dev/site_1_strip_3_test_run/*
